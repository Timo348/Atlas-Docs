# Public URL of the installation
APP_URL=http://localhost:30002
WEB_PORT=30002
COLLAB_PORT=30003
# Optional override for reverse proxies. When empty, Atlas uses the current browser-facing host and COLLAB_PORT.
COLLAB_PUBLIC_URL=
# Atlas application images can come from Docker Hub, GHCR, or an internal mirror.
ATLAS_IMAGE_REGISTRY=docker.io/timo348
# ATLAS_IMAGE_REGISTRY=ghcr.io/timo348
ATLAS_VERSION=1.5.1

# local | oidc | both
AUTH_MODE=local
AUTH_SECRET=replace-with-at-least-32-random-characters

# Initial administrator (created only when it does not exist)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Authentik / generic OpenID Connect (required for oidc or both)
OIDC_ISSUER=https://auth.example.com/application/o/atlas-docs/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional path inside the container for a mounted corporate CA bundle.
NODE_EXTRA_CA_CERTS=

# Internal infrastructure
POSTGRES_IMAGE=docker.io/library/postgres:17-alpine@sha256:742f40ea20b9ff2ff31db5458d127452988a2164df9e17441e191f3b72252193
REDIS_IMAGE=docker.io/library/redis:7.4-alpine@sha256:e7723ff73d963f5cc6d9c4643ea3d989527a402a319239054e9472a7fb9219a2
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=replace-with-a-long-database-password
DATABASE_URL=postgresql://atlas:replace-with-a-long-database-password@postgres:5432/atlas
REDIS_URL=redis://redis:6379
